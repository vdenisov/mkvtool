# IDE / build artifacts
.idea/
*.iml
# Root-anchored: an unanchored "out/" also matches the src/.../mkvtool/out/ package dir.
/out/
.claude/

# Gradle / Kotlin build (the wrapper itself — gradlew*, gradle/wrapper/ — is tracked)
build/
.gradle/
.kotlin/

# Secrets and personal data
apikey.txt
episodes.txt
episodes.txt.bak
episodes.yaml
http-client.private.env.json

# Markdown at the root is working notes; docs/ is tracked documentation. The negation is needed
# because the pattern above is unanchored and would otherwise swallow a new page in docs/ silently —
# git add says nothing about a file it is ignoring.
*.md
!CLAUDE.md
!README.md
!docs/*.md

# Test artifacts
work/
