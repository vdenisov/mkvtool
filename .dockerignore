# The build context is the repository root, because the image unpacks the Gradle wrapper's
# distribution, which needs real files from the tree. Everything else would be hundreds of megabytes
# uploaded to the daemon on every build.
#
# Keep gradlew and gradle/ - the Dockerfile copies them.

build/
.gradle/
.kotlin/
.git/
.idea/
.claude/
out/

# The media fixture the end-to-end tier derives everything from lives in the bind mount at run time;
# nothing in the image needs it.
*.mkv
